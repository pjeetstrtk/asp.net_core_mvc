@model List<BillingApp.Models.Payment>
@{
    ViewData["Title"] = "Payments";
}

<h2 class="mb-3">Payments</h2>

<div class="card shadow-sm">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Date</th>
                <th>Invoice</th>
                <th>Customer</th>
                <th>Method</th>
                <th>Reference</th>
                <th class="text-end">Amount</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.PaymentDate.ToString("dd MMM yyyy")</td>
                    <td>@p.Billing?.InvoiceNo</td>
                    <td>@p.Billing?.Customer?.Name</td>
                    <td>@p.Method</td>
                    <td>@p.Reference</td>
                    <td class="text-end">Rs. @p.Amount.ToString("N2")</td>
                    <td>
                        <a asp-controller="Billing" asp-action="Details" asp-route-id="@p.BillingId"
                           class="btn btn-sm btn-info">View</a>
                        <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>