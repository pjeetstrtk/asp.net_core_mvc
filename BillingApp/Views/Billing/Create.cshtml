@{
    ViewData["Title"] = "New Invoice";
    var products = ViewBag.Products as List<BillingApp.Models.Product>;
    var customers = ViewBag.Customers as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<h2>New Invoice</h2>

<form method="post" class="card p-4 shadow-sm mt-3">
    <div class="mb-3">
        <label class="form-label">Customer</label>
        <select name="customerId" class="form-select" asp-items="customers" required>
            <option value="">-- Select Customer --</option>
        </select>
    </div>

    <h5>Items</h5>
    <table class="table" id="itemsTable">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Qty</th>
                <th></th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <div class="mb-3">
        <select id="productSelect" class="form-select">
            <option value="">-- Select Product --</option>
            @foreach (var p in products!)
            {
                <option value="@p.Id" data-price="@p.Price">@p.Name - Rs. @p.Price (@p.Stock left)</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <button type="button" class="btn btn-outline-primary" onclick="addRow()">Add Item</button>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <h4>Total: Rs. <span id="total">0.00</span></h4>
    </div>

    <div>
        <button class="btn btn-primary">Generate Invoice</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        function addRow() {
            const sel = document.getElementById('productSelect');
            if (!sel.value) return;
            const opt = sel.options[sel.selectedIndex];
            const price = parseFloat(opt.dataset.price);
            const name = opt.text;
            const id = sel.value;

            const tbody = document.querySelector('#itemsTable tbody');
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${name}<input type="hidden" name="productIds" value="${id}" /></td>
                <td>Rs. ${price.toFixed(2)}</td>
                <td><input type="number" name="quantities" value="1" min="1" class="form-control form-control-sm qty" style="width:80px" /></td>
                <td><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">X</button></td>
            `;
            tbody.appendChild(tr);
            tr.querySelector('.qty').addEventListener('input', calcTotal);
            tr.dataset.price = price;
            calcTotal();
        }

        function removeRow(btn) {
            btn.closest('tr').remove();
            calcTotal();
        }

        function calcTotal() {
            let total = 0;
            document.querySelectorAll('#itemsTable tbody tr').forEach(tr => {
                const price = parseFloat(tr.dataset.price);
                const qty = parseInt(tr.querySelector('.qty').value) || 0;
                total += price * qty;
            });
            document.getElementById('total').textContent = total.toFixed(2);
        }
    </script>
}