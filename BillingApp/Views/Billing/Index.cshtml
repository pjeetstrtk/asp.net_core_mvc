@model List<BillingApp.Models.Billing>
@{ ViewData["Title"] = "Billing"; }

<div class="d-flex justify-content-between mb-3">
    <h2>Billings</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> New Invoice</a>
</div>

<div class="card shadow-sm">
    <table class="table mb-0">
        <thead>
            <tr><th>Invoice</th><th>Customer</th><th>Date</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th><th width="220"></th></tr>
        </thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.InvoiceNo</td>
                <td>@b.Customer?.Name</td>
                <td>@b.BillDate.ToString("dd MMM yyyy")</td>
                <td>Rs. @b.TotalAmount.ToString("N2")</td>
                <td>Rs. @b.PaidAmount.ToString("N2")</td>
                <td>Rs. @b.BalanceAmount.ToString("N2")</td>
                <td>
                    <span class="badge bg-@(b.Status == "Paid" ? "success" : b.Status == "Partial" ? "warning" : "secondary")">@b.Status</span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-info">View</a>
                    <a asp-controller="Reports" asp-action="DownloadInvoice" asp-route-id="@b.Id" class="btn btn-sm btn-success">PDF</a>
                    @if (b.Status != "Paid")
                    {
                        <a asp-controller="Payment" asp-action="Create" asp-route-billingId="@b.Id" class="btn btn-sm btn-warning">Pay</a>
                    }
                    <a asp-action="Delete" asp-route-id="@b.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>