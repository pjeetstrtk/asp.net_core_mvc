@model BillingApp.Models.Billing
@{
    ViewData["Title"] = "Invoice Details";
}

<div class="d-flex justify-content-between mb-3 d-print-none">
    <h2>Invoice: @Model.InvoiceNo</h2>
    <div>
        <a asp-controller="Reports" asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn btn-success">
            <i class="bi bi-file-earmark-pdf"></i> Download PDF
        </a>
        <a asp-controller="Reports" asp-action="Invoice" asp-route-id="@Model.Id" class="btn btn-info">View Invoice</a>
        @if (Model.Status != "Paid")
        {
            <a asp-controller="Payment" asp-action="Create" asp-route-billingId="@Model.Id" class="btn btn-warning">Add
                Payment</a>
            }
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    <div class="card shadow-sm p-4">
        <div class="row mb-4">
            <div class="col-md-6">
                <h5>Customer</h5>
                <p>
                    <b>@Model.Customer?.Name</b><br />
                    @Model.Customer?.Email<br />
                    @Model.Customer?.Phone<br />
                    @Model.Customer?.Address
                </p>
            </div>
            <div class="col-md-6 text-end">
                <p>
                    <b>Invoice #:</b> @Model.InvoiceNo<br />
                    <b>Date:</b> @Model.BillDate.ToString("dd MMM yyyy HH:mm")<br />
                    <b>Status:</b>
                    <span
                    class="badge bg-@(Model.Status == "Paid" ? "success" : Model.Status == "Partial" ? "warning" : "secondary")">@Model.Status</span>
                </p>
            </div>
        </div>

        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Product?.Name</td>
                        <td>Rs. @item.UnitPrice.ToString("N2")</td>
                        <td>@item.Quantity</td>
                        <td class="text-end">Rs. @item.LineTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Subtotal</th>
                    <th class="text-end">Rs. @Model.TotalAmount.ToString("N2")</th>
                </tr>
                <tr>
                    <th colspan="3" class="text-end">Paid</th>
                    <th class="text-end">Rs. @Model.PaidAmount.ToString("N2")</th>
                </tr>
                <tr class="table-warning">
                    <th colspan="3" class="text-end">Balance</th>
                    <th class="text-end">Rs. @Model.BalanceAmount.ToString("N2")</th>
                </tr>
            </tfoot>
        </table>

        @if (Model.Payments.Any())
        {
            <h5>Payments</h5>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Method</th>
                        <th>Reference</th>
                        <th class="text-end">Amount</th>
                        <th class="d-print-none"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        <tr>
                            <td>@p.PaymentDate.ToString("dd MMM yyyy")</td>
                            <td>@p.Method</td>
                            <td>@p.Reference</td>
                            <td class="text-end">Rs. @p.Amount.ToString("N2")</td>
                            <td class="d-print-none"><a asp-controller="Payment" asp-action="Delete" asp-route-id="@p.Id"
                                                            class="btn btn-sm btn-danger">Delete</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>