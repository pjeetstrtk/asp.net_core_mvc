<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Billing App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body { background: #f4f6f9; }
        .sidebar { min-height: 100vh; background: #1f2937; color: #fff; }
        .sidebar a { color: #cbd5e1; text-decoration: none; padding: 12px 20px; display: block; }
        .sidebar a:hover, .sidebar a.active { background: #374151; color: #fff; }
        .sidebar h4 { padding: 20px; border-bottom: 1px solid #374151; }
        .content { padding: 20px; }
        .stat-card { border-radius: 12px; color: #fff; padding: 20px; }
        .stat-card h6 { opacity: 0.9; }
        @@media print {
            .sidebar, .d-print-none { display: none !important; }
            .content { width: 100% !important; max-width: 100% !important; flex: 0 0 100% !important; }
        }
    </style>
</head>
<body>
@if (Context.Session.GetInt32("UserId") != null)
{
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 sidebar p-0 d-print-none">
                <h4><i class="bi bi-receipt"></i> BillingApp</h4>
                <a asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a asp-controller="Customer" asp-action="Index"><i class="bi bi-people"></i> Customers</a>
                <a asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam"></i> Products</a>
                <a asp-controller="Billing" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Billing</a>
                <a asp-controller="Payment" asp-action="Index"><i class="bi bi-cash-coin"></i> Payments</a>
                <a asp-controller="Reports" asp-action="Index"><i class="bi bi-graph-up"></i> Reports</a>
                <hr class="text-secondary" />
                <a asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
            </nav>
            <main class="col-md-10 content">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <main class="container mt-5">
        @RenderBody()
    </main>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>