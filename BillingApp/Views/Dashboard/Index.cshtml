@model List<BillingApp.Models.Billing>
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card" style="background:#2563eb;">
            <h6>Total Customers</h6>
            <h2>@ViewBag.TotalCustomers</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background:#059669;">
            <h6>Total Products</h6>
            <h2>@ViewBag.TotalProducts</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background:#7c3aed;">
            <h6>Total Billings</h6>
            <h2>@ViewBag.TotalBillings</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background:#dc2626;">
            <h6>Pending Amount</h6>
            <h2>Rs. @(((decimal)ViewBag.PendingAmount).ToString("N2"))</h2>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header"><b>Recent Billings</b></div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Invoice</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.InvoiceNo</td>
                        <td>@b.Customer?.Name</td>
                        <td>@b.BillDate.ToString("dd MMM yyyy")</td>
                        <td>Rs. @b.TotalAmount.ToString("N2")</td>
                        <td>
                            <span
                                class="badge bg-@(b.Status == "Paid" ? "success" : b.Status == "Partial" ? "warning" : "secondary")">
                                @b.Status
                            </span>
                        </td>
                        <td><a asp-controller="Billing" asp-action="Details" asp-route-id="@b.Id"
                                   class="btn btn-sm btn-outline-primary">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>